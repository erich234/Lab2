<?xml version="1.0"?>
<robot name="table">

<!-- define the colors -->
<material name="brown">
    <color rgba="0.54 0.27 0.07 1.0"/>
</material>
<material name="light_grey">
    <color rgba="0.8 0.8 0.8 1.0"/>
</material>
  
  <!-- create link fixed to the "world" -->
  <link name="world" />
  
  <!-- joint from "world" to "table_top"-->
  <joint name="top" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 1" />
    <parent link="world" />
    <child link="top" />
  </joint>

  <!-- Table Top -->
  <link name="top">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.025" />
      <geometry>
        <box size="2 1 -0.05" />
      </geometry>
      <material name="brown" />
    </visual>
  </link>   

  <!-- joint from "top" to "leg1"-->
  <joint name="leg_joint" type="fixed">
    <origin rpy="0 0 0" xyz=".95 0.45 -0.05" />
    <parent link="top" />
    <child link="leg1" />
  </joint>

  <!-- Leg One -->
  <link name="leg1">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.475" />
      <geometry>
        <cylinder radius="0.05" length="0.95" />
      </geometry>
      <material name="light_grey" />
    </visual>
  </link>

  <!-- joint from "top" to "leg2"-->
  <joint name="leg_joint2" type="fixed">
    <origin rpy="0 0 0" xyz="-.95 0.45 -0.05" />
    <parent link="top" />
    <child link="leg2" />
  </joint>

  <!-- Leg Two -->
  <link name="leg2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.475" />
      <geometry>
        <cylinder radius="0.05" length="0.95" />
      </geometry>
      <material name="light_grey" />
    </visual>
  </link>  

  <!-- joint from "top" to "leg2"-->
  <joint name="leg_joint3" type="fixed">
    <origin rpy="0 0 0" xyz=".95 -0.45 -0.05" />
    <parent link="top" />
    <child link="leg3" />
  </joint>

  <!-- Leg Three -->
  <link name="leg3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.475" />
      <geometry>
        <cylinder radius="0.05" length="0.95" />
      </geometry>
      <material name="light_grey" />
    </visual>
  </link>    

  <!-- joint from "top" to "leg4"-->
  <joint name="leg_joint4" type="fixed">
    <origin rpy="0 0 0" xyz="-.95 -0.45 -0.05" />
    <parent link="top" />
    <child link="leg4" />
  </joint>

  <!-- Leg Four -->
  <link name="leg4">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.475" />
      <geometry>
        <cylinder radius="0.05" length="0.95" />
      </geometry>
      <material name="light_grey" />
    </visual>
  </link>   
  
</robot>